# Copy this file to .env in this folder and fill in your own values:
#   cp phase-2-modelling/day-021-config-loader/.env.example phase-2-modelling/day-021-config-loader/.env
# .env is in .gitignore. Never commit it. These values are fake.

# development, staging or production
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://chama:chama@localhost:5432/chama?sslmode=disable

# From your app on the Daraja developer portal. Required.
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret

# A Go duration: 500ms, 5s, 1m
REQUEST_TIMEOUT=5s
DEBUG=true
